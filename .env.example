# Authentik Media Gateway - Environment Configuration
# Copy this file to .env and update the values as needed.

# Application Settings
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# S3/MinIO Settings
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=media-gateway
S3_KEY_PREFIX=uploads/
S3_PRESIGNED_TTL_SECONDS=300
S3_TIMEOUT_SECONDS=30

# Security and Limits
MAX_DOWNLOAD_BYTES=10485760
ALLOWED_CONTENT_TYPES=["audio/wav", "audio/webm", "audio/mpeg"]
